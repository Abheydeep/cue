<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Cue"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1a1a2e"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart replies for WhatsApp &amp; Hinge"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="32dp"/>

    <!-- API Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemini API Key"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AIza..."
        android:inputType="textPassword"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save API Key"
        android:backgroundTint="#1a1a2e"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <!-- Permissions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERMISSIONS REQUIRED"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textColor="#999999"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="1. Grant Overlay Permission"
        android:backgroundTint="#4a7db5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="2. Enable Accessibility Service"
        android:backgroundTint="#4a7db5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <!-- Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STATUS"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textColor="#999999"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="#333333"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
